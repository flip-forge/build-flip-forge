{
  "name": "build-flip-forge",
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-action": "tsx ./build/action.ts",
    "build-test": "tsx ./build/cli.ts --title='Lorem Ipsum' --description='Test description' --write-env test/lorem_ipsum.pdf",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "style:fix": "run-s -c format",
    "style:check": "run-s -c format:check"
  },
  "dependencies": {
    "@flip-forge/vue-flip-forge": "0.3.1",
    "@vueuse/router": "14.2.1",
    "vue": "3.5.30",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.59.0",
    "@tsconfig/node22": "22.0.5",
    "@types/jsdom": "28.0.1",
    "@types/node": "25.5.0",
    "@vitejs/plugin-vue": "6.0.5",
    "@vue/tsconfig": "0.9.0",
    "husky": "9.1.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.1",
    "vue-tsc": "3.2.6",
    "@vue/test-utils": "2.4.6",
    "commander": "14.0.3",
    "cypress": "15.12.0",
    "jsdom": "29.0.1",
    "lint-staged": "16.4.0",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.1",
    "start-server-and-test": "2.1.5",
    "vitest": "4.1.0"
  }
}
